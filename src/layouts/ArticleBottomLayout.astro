---
import { type CollectionEntry, getCollection } from "astro:content"

type Props = {
  entry: CollectionEntry<"projects">
}

const { entry } = Astro.props
const { Content } = await entry.render()
const items = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex((item) => item.slug === entry.slug)
const previous = items[(index - 1 + items.length) % items.length]
const next = items[(index + 1) % items.length]
---

<div>
  <article class="max-w-3xl">
    <Content />
  </article>

  <nav aria-label="项目翻页" class="grid gap-4 border-t border-black/10 pt-8 sm:grid-cols-2 dark:border-white/15">
    <a href={`/projects/${previous.slug}`} class="group flex items-center gap-3 rounded-lg border border-black/10 p-4 transition hover:border-accent dark:border-white/15">
      <svg class="size-5 shrink-0 rotate-180 stroke-current transition-transform group-hover:-translate-x-1">
        <use href="/ui.svg#arrow-right"></use>
      </svg>
      <div>
        <div class="text-xs text-black/50 dark:text-white/50">上一个项目</div>
        <div class="mt-1 font-semibold text-black group-hover:text-accent dark:text-white">{previous.data.title}</div>
      </div>
    </a>
    <a href={`/projects/${next.slug}`} class="group flex items-center justify-between gap-3 rounded-lg border border-black/10 p-4 text-right transition hover:border-accent dark:border-white/15">
      <div class="ml-auto">
        <div class="text-xs text-black/50 dark:text-white/50">下一个项目</div>
        <div class="mt-1 font-semibold text-black group-hover:text-accent dark:text-white">{next.data.title}</div>
      </div>
      <svg class="size-5 shrink-0 stroke-current transition-transform group-hover:translate-x-1">
        <use href="/ui.svg#arrow-right"></use>
      </svg>
    </a>
  </nav>
</div>
