---
import type { CollectionEntry } from "astro:content"
import { formatDate } from "@lib/utils"

type Props = {
  entry: CollectionEntry<"projects">
  priority?: boolean
}

const { entry, priority = false } = Astro.props
const { title, summary, date, tags, image, imageAlt } = entry.data
---

<a
  href={`/projects/${entry.slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-black/10 bg-white transition duration-300 hover:-translate-y-1 hover:border-accent/50 dark:border-white/15 dark:bg-black"
>
  <div class="aspect-[2/1] overflow-hidden bg-neutral-100 dark:bg-neutral-900">
    <img
      src={image}
      alt={imageAlt}
      width="1280"
      height="640"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      class="size-full object-cover transition duration-500 group-hover:scale-[1.02]"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="text-xs text-black/55 dark:text-white/55">{formatDate(date)}</div>
    <h3 class="mt-2 text-xl font-semibold text-black transition-colors group-hover:text-accent dark:text-white">
      {title}
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed">{summary}</p>
    <div class="mt-5 flex items-end justify-between gap-4">
      <ul class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-black/55 dark:text-white/55">
        {tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
      <svg class="size-5 shrink-0 stroke-current transition-transform duration-300 group-hover:translate-x-1">
        <use href="/ui.svg#arrow-right"></use>
      </svg>
    </div>
  </div>
</a>
