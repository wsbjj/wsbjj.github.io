---
import { SITE } from "@consts"
import Container from "@components/Container.astro"
---

<footer class="relative border-t border-black/10 bg-white dark:border-white/15 dark:bg-black">
  <Container size="lg">
    <div class="grid gap-8 py-10 sm:grid-cols-2 sm:items-end">
      <div>
        <a href="/" class="inline-flex items-center gap-2 font-semibold text-black transition-colors hover:text-accent dark:text-white">
          <span class="grid size-8 place-items-center rounded-lg bg-accent text-xs font-bold text-white">BJ</span>
          {SITE.TITLE}
        </a>
        <p class="mt-3 max-w-md text-sm">
          关注 AI Agent、多智能体协作、全栈应用与物联网。
        </p>
      </div>

      <div class="flex flex-col items-start gap-4 sm:items-end">
        <div class="flex items-center gap-2">
          <a
            href="https://github.com/wsbjj"
            target="_blank"
            rel="noreferrer"
            aria-label="访问 Bu Junjie 的 GitHub 主页"
            class="grid size-10 place-items-center rounded-lg border border-black/10 transition-colors hover:bg-black/5 dark:border-white/20 dark:hover:bg-white/10"
          >
            <svg class="size-5 fill-current">
              <use href="/social.svg#github"></use>
            </svg>
          </a>
          <button
            id="back-to-top"
            aria-label="返回页面顶部"
            title="返回顶部"
            class="grid size-10 place-items-center rounded-lg border border-black/10 transition-colors hover:bg-black/5 dark:border-white/20 dark:hover:bg-white/10"
          >
            <svg class="size-5 -rotate-90 stroke-current">
              <use href="/ui.svg#arrow-right"></use>
            </svg>
          </button>
        </div>
        <p class="text-sm">
          &copy; {new Date().getFullYear()} Bu Junjie
          <span class="mx-2 text-black/30 dark:text-white/30">/</span>
          基于 <a class="underline underline-offset-4 hover:text-accent" href="https://github.com/markhorn-dev/astro-sphere" target="_blank" rel="noreferrer">Astro Sphere</a> 构建
        </p>
      </div>
    </div>
  </Container>
</footer>

<script is:inline>
  function initializeBackToTop() {
    const button = document.getElementById("back-to-top")
    if (button) {
      button.onclick = () => {
        window.scrollTo({
          top: 0,
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        })
      }
    }
  }

  document.addEventListener("astro:after-swap", initializeBackToTop)
  initializeBackToTop()
</script>
