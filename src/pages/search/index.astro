---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import Search from "@components/Search"
import { SEARCH } from "@consts"

const projects = (await getCollection("projects")).filter((project) => !project.data.draft)
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <div class="animate max-w-2xl">
      <h1 class="text-4xl font-semibold text-black dark:text-white">{SEARCH.TITLE}</h1>
      <p class="mt-3 text-lg">{SEARCH.DESCRIPTION}</p>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate pb-16">
      <Search client:load data={projects} />
    </div>
  </BottomLayout>
</PageLayout>
